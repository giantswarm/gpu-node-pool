{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "required": [
                "name",
                "organization",
                "baseDomain",
                "managementCluster"
            ],
            "additionalProperties": true,
            "properties": {
                "baseDomain": {
                    "type": "string",
                    "description": "Base domain of the installation (the cluster's `global.connectivity.baseDomain`)."
                },
                "cilium": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "ipamMode": {
                            "type": "string",
                            "description": "Cilium IPAM mode of the cluster; decides the unmanaged-devices network unit.",
                            "enum": [
                                "kubernetes",
                                "eni"
                            ]
                        }
                    }
                },
                "containerRegistry": {
                    "type": "string",
                    "description": "Registry containerd pulls the sandbox (pause) image from."
                },
                "kubelet": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "maxPods": {
                            "type": "integer",
                            "description": "Maximum pods per node as the cluster's kubelet patch sets it."
                        }
                    }
                },
                "managementCluster": {
                    "type": "string",
                    "description": "Name of the management cluster (the cluster's `global.managementCluster`)."
                },
                "name": {
                    "type": "string",
                    "description": "Name of the existing Cluster API cluster the pool joins.",
                    "pattern": "^(|[a-z0-9][-a-z0-9]{0,18}[a-z0-9])$"
                },
                "organization": {
                    "type": "string",
                    "description": "Organization owning the cluster; the release lives in `org-<organization>`."
                },
                "proxy": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Route containerd, kubelet, teleport and the kubeadm commands through the cluster's HTTP proxy."
                        },
                        "httpProxy": {
                            "type": "string",
                            "description": "HTTP proxy URL."
                        },
                        "httpsProxy": {
                            "type": "string",
                            "description": "HTTPS proxy URL."
                        },
                        "noProxy": {
                            "type": "string",
                            "description": "Comma-separated no-proxy list as the cluster computes it."
                        }
                    }
                },
                "registryMirrors": {
                    "type": "object",
                    "description": "Registry mirrors as containerd `hosts.toml` files: registry host -> ordered list of endpoint hosts (a snapshot of the cluster's mirrors and local registry cache).",
                    "additionalProperties": true
                }
            }
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key."
        },
        "pool": {
            "type": "object",
            "required": [
                "name",
                "kubernetesVersion",
                "machineImage"
            ],
            "additionalProperties": false,
            "properties": {
                "accelerator": {
                    "type": "string",
                    "description": "Accelerator from the curated list; picks the EC2 instance family.",
                    "enum": [
                        "nvidia-l4",
                        "nvidia-a10g",
                        "nvidia-t4",
                        "nvidia-l40s"
                    ]
                },
                "consolidateAfter": {
                    "type": "string",
                    "description": "Time an empty or underutilized node lives before Karpenter consolidates it."
                },
                "kubernetesVersion": {
                    "type": "string",
                    "description": "Kubernetes version the pool's nodes run (`1.33.1`), never newer than the control plane.",
                    "pattern": "^(|[0-9]+\\.[0-9]+\\.[0-9]+)$"
                },
                "machineImage": {
                    "type": "string",
                    "description": "Name of the Flatcar machine image (`flatcar-<channel>-<flatcar>-kube-<k8s>-tooling-<tooling>-gs`)."
                },
                "maxSize": {
                    "type": "object",
                    "description": "Upper bound of the pool, as Karpenter limits (resources across all of its nodes).",
                    "additionalProperties": true,
                    "properties": {
                        "nvidia.com/gpu": {
                            "type": "string"
                        }
                    }
                },
                "minSize": {
                    "type": "integer",
                    "description": "Minimum size; Karpenter scales the pool to zero when nothing is scheduled.",
                    "enum": [
                        0
                    ]
                },
                "name": {
                    "type": "string",
                    "description": "Name of the node pool within the cluster; five to twenty characters.",
                    "pattern": "^(|[a-z0-9][-a-z0-9]{3,18}[a-z0-9])$"
                },
                "prewarm": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Launch the pool's first node at install: a one-shot Job holds one GPU at negative priority until the first workload preempts it. Only for the installation's own pool, where the release namespace is on the cluster the nodes join."
                        },
                        "holdMinutes": {
                            "type": "integer",
                            "description": "Minutes the placeholder holds the node when no workload comes; then it ends and Karpenter consolidates the empty node.",
                            "maximum": 1440,
                            "minimum": 1
                        },
                        "image": {
                            "type": "string",
                            "description": "Image of the placeholder; anything with `sleep`."
                        }
                    }
                },
                "sizes": {
                    "type": "array",
                    "description": "Instance sizes Karpenter may pick within the accelerator's family, smallest first.",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "volumes": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "lib": {
                            "type": "string",
                            "description": "`/var/lib` volume (container images, kubelet)."
                        },
                        "libIops": {
                            "type": "integer",
                            "description": "Provisioned IOPS of the `/var/lib` volume. gp3 allows 3000 to 16000.",
                            "maximum": 16000,
                            "minimum": 3000
                        },
                        "libThroughput": {
                            "type": "integer",
                            "description": "Provisioned throughput of the `/var/lib` volume in MiB/s; image pulls on a fresh node are bounded by it. gp3 allows 125 to 1000 and at most 0.25 MiB/s per provisioned IOPS.",
                            "maximum": 1000,
                            "minimum": 125
                        },
                        "log": {
                            "type": "string",
                            "description": "`/var/log` volume."
                        },
                        "root": {
                            "type": "string",
                            "description": "Root volume."
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "subscriptionID": {
            "type": "string"
        },
        "teleport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Join the nodes to Teleport with the cluster's `<cluster>-teleport-join-token` Secret; off where the cluster has none."
                }
            }
        }
    }
}
